# Copie este archivo a ".env" (en la raíz del proyecto, junto a manage.py) y
# ajuste los valores según su entorno. El archivo .env NO debe subirse a un
# repositorio público (ya está incluido en .gitignore).

# Clave secreta de Django. Genere una propia para producción, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion-2026

# Modo de depuración. Use True solo en desarrollo.
DJANGO_DEBUG=True

# Hosts permitidos (separados por comas)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos MySQL (XAMPP) ---
# Configuración por defecto para XAMPP en Windows: servidor MySQL en
# 127.0.0.1:3306, usuario "root" sin contraseña.
DB_NAME=obras_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Los umbrales del semáforo de avance (RF-14, RF-32) se configuran desde el
# panel de administración: Sistema > Configuración del sistema.

# --- Correo electrónico (RF-05: recuperación de contraseña) ---
# En desarrollo no es necesario completar nada: el correo se imprime en la
# consola del servidor (EMAIL_BACKEND=console por defecto cuando DEBUG=True).
# Para que la recuperación de contraseña envíe un correo real, descomente y
# complete estos datos con una cuenta de correo de la entidad (o de Gmail
# con una "contraseña de aplicación", no la contraseña normal de la cuenta):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=sistema.obras@santarosa.gob.pe
# EMAIL_HOST_PASSWORD=contraseña-de-aplicacion
# DEFAULT_FROM_EMAIL=Sistema de Obras Públicas <sistema.obras@santarosa.gob.pe>

# --- Producción (DJANGO_DEBUG=False) ---
# DJANGO_HTTPS=True activa cookies seguras y redirección a HTTPS cuando el sitio tenga certificado.
# DJANGO_HTTPS=False
# PDF_PROCESOS=2
# SUBIDA_MAX_MB=20
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Copias de respaldo (RNF-18): python manage.py respaldar_bd ---
BACKUP_DIR=backups
BACKUP_CONSERVAR=15
MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
